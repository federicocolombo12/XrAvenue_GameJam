  m_Script: {fileID: 11500000, guid: 0eeff1f6f86f4ab68001f3e68708e63e, type: 3}
  m_Name: Day4Killed_Dialogues_Boss_Intro
  m_EditorClassIdentifier: Assembly-CSharp::AvenueXR.Core.DialogueData
  lines:
  - speaker: 0
    speakerName: 
    text: I miei complimenti.
    voiceClip: {fileID: 0}
  - speaker: 0
    speakerName: 
    text: Come ti senti? Ti senti soddisfatto? Pesni di aver fatto un buon lavoro?
    voiceClip: {fileID: 0}
  - speaker: 0
    speakerName: 
    text: Ieri sei stato molto intelligente.
    voiceClip: {fileID: 0}
  - speaker: 0
    speakerName: 
    text: Abbiamo seguito i tuoi movimenti e siamo fieri della tua decisione finale.
    voiceClip: {fileID: 0}
  - speaker: 0
    speakerName: 
    text: "Purtroppo per\xF2 la sicurezza non \xE8 mai troppa. "
    voiceClip: {fileID: 0}
  - speaker: 0
    speakerName: 
    text: "Sei stato un cane ubbidiente, ma ora \xE8 tempo di tornare a cuccia, in
      mezzo alla terra."
    voiceClip: {fileID: 0}
  basePauseSeconds: 0.6
  secondsPerCharacter: 0.04
  minPauseSeconds: 0.5
  maxPauseSeconds: 4
