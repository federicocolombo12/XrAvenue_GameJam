  lines:
  - speaker: 0
    speakerName: 
    text: Sei stato un dipendente eccezionale, i miei complimenti.
    voiceClip: {fileID: 0}
  - speaker: 0
    speakerName: 
    text: "Hai dimostrato molta pi\xF9 cura di chi ti ha preceduto."
    voiceClip: {fileID: 0}
  - speaker: 0
    speakerName: 
    text: Hai un'ultimo compito prima di chiudere. Svolgi il tuo lavoro al meglio.
      Come hai sempre fatto.
