  m_Name: Day4Gun_Dialogues_Boss1
  m_EditorClassIdentifier: Assembly-CSharp::AvenueXR.Core.DialogueData
  lines:
  - speaker: 0
    speakerName: 
    text: "La scelta non \xE8 mai stata tua."
    voiceClip: {fileID: 0}
  - speaker: 0
    speakerName: 
    text: Come ti senti? Ti senti soddisfatto? Pesni di aver fatto un buon lavoro?
    voiceClip: {fileID: 0}
  - speaker: 0
    speakerName: 
    text: "Tu sei una pedina, e non hai possibilit\xE0 di fuggire. Ogni tuo tentativo
      \xE8 vano."
    voiceClip: {fileID: 0}
  - speaker: 0
    speakerName: 
    text: Poni fine a questa perdita di tempo.
    voiceClip: {fileID: 0}
