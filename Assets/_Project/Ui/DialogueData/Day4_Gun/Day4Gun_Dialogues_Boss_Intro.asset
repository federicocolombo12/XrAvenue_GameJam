  lines:
  - speaker: 0
    speakerName: 
    text: Sei qui da 4 giorni.
    voiceClip: {fileID: 0}
  - speaker: 0
    speakerName: 
    text: Come ti senti? Ti senti soddisfatto? Pesni di aver fatto un buon lavoro?
    voiceClip: {fileID: 0}
  - speaker: 0
    speakerName: 
    text: 'Credi di aver avuto un''impatto in questo modno? Credi di aver avuto un
      ruolo? '
    voiceClip: {fileID: 0}
  - speaker: 0
    speakerName: 
    text: Credi davvero di essere importante?
    voiceClip: {fileID: 0}
