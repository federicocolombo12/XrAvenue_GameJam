  lines:
  - speaker: 1
    speakerName: 
    text: Ciao...
    voiceClip: {fileID: 0}
  - speaker: 1
    speakerName: 
    text: 'Mi hanno chiesto di consegnarti questa foto. '
    voiceClip: {fileID: 0}
  - speaker: 1
    speakerName: 
    text: Ritrae me con mia madre tanti anni fa, prima che venisse arrestata
    voiceClip: {fileID: 0}
  - speaker: 1
    speakerName: 
    text: Ha un grande valore sentimentale per me...Potresti ridarmela?
    voiceClip: {fileID: 0}
