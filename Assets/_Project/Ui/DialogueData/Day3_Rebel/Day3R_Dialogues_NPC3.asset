  m_Script: {fileID: 11500000, guid: 0eeff1f6f86f4ab68001f3e68708e63e, type: 3}
  m_Name: Day3R_Dialogues_NPC3
  m_EditorClassIdentifier: Assembly-CSharp::AvenueXR.Core.DialogueData
  lines:
  - speaker: 1
    text: "C'\xE8 speranza per tutti noi, dobbiamo solo saperne approfittare"
  - speaker: 1
    text: Non farti vedere, nascondi la bomba nel cassetto
  - speaker: 1
    text: "Questo \xE8 un punto di riciclo estremamente profittevole per il governo"
  - speaker: 1
    text: "Fai in modo che non possano pi\xF9 approfittarsi di noi"
  - speaker: 1
    text: Il sacrificio di uno, per la salvezza di tutti
