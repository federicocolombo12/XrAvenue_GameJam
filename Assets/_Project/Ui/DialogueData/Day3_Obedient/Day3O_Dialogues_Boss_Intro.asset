  lines:
  - speaker: 0
    speakerName: 
    text: Ti sei impegnato lo scorso giorno. Ottimo.
    voiceClip: {fileID: 0}
  - speaker: 0
    speakerName: 
    text: Mi aspetto di continuare ad osservare lo stesso comportamento quest'oggi.
    voiceClip: {fileID: 0}
  - speaker: 0
    speakerName: 
    text: "Sii devoto a questo paese, e ringrazia della poszione che ti \xE8 stata
      data."
    voiceClip: {fileID: 0}
